<?xml version="1.0" encoding="UTF-8"?>
<Actions>
    <!-- NO uiPath, deliberately. With one, these actions get filed inside
         Indigo's own "Device Actions" submenu alongside the built-in Turn On /
         Turn Off / Toggle, and it is far too easy to pick the relay's built-in
         Toggle instead of this plugin's. Without it they appear under the
         plugin's own name in the picker, which is unambiguous.

         NO ConfigUI either. An action with a ConfigUI must have its dialog
         completed, and an unfinished one saves as a step that fails at run time
         with "Action has not been completely configured". These need no
         parameters, so they should not ask for any. -->
    <Action id="openDoor" deviceFilter="self.garageDoor">
        <Name>Open Garage Door</Name>
        <CallbackMethod>actionOpenDoor</CallbackMethod>
    </Action>
    <Action id="closeDoor" deviceFilter="self.garageDoor">
        <Name>Close Garage Door</Name>
        <CallbackMethod>actionCloseDoor</CallbackMethod>
    </Action>
    <Action id="toggleDoor" deviceFilter="self.garageDoor">
        <Name>Toggle Garage Door</Name>
        <CallbackMethod>actionToggleDoor</CallbackMethod>
    </Action>
    <Action id="pulseRelay" deviceFilter="self.garageDoor">
        <Name>Pulse Relay (diagnostic)</Name>
        <CallbackMethod>actionPulseRelay</CallbackMethod>
    </Action>
    <Action id="refreshState" deviceFilter="self.garageDoor">
        <Name>Re-read Door State</Name>
        <CallbackMethod>actionRefreshState</CallbackMethod>
    </Action>
</Actions>
